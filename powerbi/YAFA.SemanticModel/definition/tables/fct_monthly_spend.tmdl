/// Monthly actuals. The forecast is monthly, so actuals are pre-aggregated to
/// the same grain -- otherwise the two can't share an axis without a DAX
/// rollup on every visual.
table fct_monthly_spend
	lineageTag: a1b2c3d4-4444-4a04-9e44-000000000001

	column user_id
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: a1b2c3d4-4444-4a04-9e44-000000000002
		summarizeBy: none
		sourceColumn: user_id

	column month_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: a1b2c3d4-4444-4a04-9e44-000000000003
		summarizeBy: none
		sourceColumn: month_start

	column category_key
		dataType: string
		lineageTag: a1b2c3d4-4444-4a04-9e44-000000000004
		summarizeBy: none
		sourceColumn: category_key

	column total_amount
		dataType: decimal
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: a1b2c3d4-4444-4a04-9e44-000000000005
		summarizeBy: sum
		sourceColumn: total_amount

	column transaction_count
		dataType: int64
		formatString: #,0
		lineageTag: a1b2c3d4-4444-4a04-9e44-000000000006
		summarizeBy: sum
		sourceColumn: transaction_count

	partition fct_monthly_spend = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(ServerParam, DatabaseParam),
				    Data = Source{[Schema="public", Item="vw_powerbi_fct_monthly_spend"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
