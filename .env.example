# Copy to .env and fill in. Everything the API reads is prefixed YAFA_.
#   cp .env.example .env

# --- required ---------------------------------------------------------------
# The API refuses to start without this, and rejects anything under 32 chars.
# Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
YAFA_JWT_SECRET=

# --- database ---------------------------------------------------------------
# Matches the docker-compose defaults. Point elsewhere for a managed Postgres.
YAFA_DATABASE_URL=postgresql+asyncpg://yafa:yafa@localhost:55432/yafa

# Consumed by the postgres container itself (not the app).
POSTGRES_USER=yafa
POSTGRES_PASSWORD=yafa
POSTGRES_DB=yafa
# Host-side port. Deliberately high: local PostgreSQL installs commonly own
# 5432 AND 5433 (one per major version), and the connection silently reaches
# those instead, surfacing as an auth failure rather than a port clash.
POSTGRES_HOST_PORT=55432

# --- services ---------------------------------------------------------------
YAFA_QDRANT_URL=http://localhost:6333

# --- optional: LLM fallback -------------------------------------------------
# Only used when the regex/word-number layers fail to parse a transcript.
# Leave empty to run fully local -- the pipeline degrades gracefully.
ANTHROPIC_API_KEY=

# --- optional: tuning -------------------------------------------------------
# auto | cuda | cpu. "auto" picks cuda when torch reports a device.
YAFA_WHISPER_DEVICE=auto
# base.en is faster; small.en is noticeably more accurate on a GPU.
YAFA_WHISPER_MODEL_SIZE=small.en

YAFA_LOG_LEVEL=INFO
YAFA_LOG_JSON=false
YAFA_OTEL_ENABLED=false
